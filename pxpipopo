-- SKILL ACTIVATION
local function activateSkill(key)
    local char = player.Character
    local sukuna = char and char:FindFirstChild("Sukuna")
    local skill = sukuna and sukuna:FindFirstChild("Skill")
    local ev = skill and skill:FindFirstChild("SkillEvent")


    if ev and ev:IsA("RemoteEvent") then
        ev:FireServer(key)
    end
end

-- METEORITE HELPERS
local function pivotOf(inst)
    if inst and inst:IsA("PVInstance") then
        return inst:GetPivot()
    end
    return nil
end

local function getMeteoriteCFrame(fromPosition)
    local mod = workspace:FindFirstChild("Mod")
    local folder = mod and mod:FindFirstChild("MeteoriteEvent")
    if not folder then return nil end

    local children = folder:GetChildren()
    local found = {}

    for _, name in ipairs(METEORITE_NAMES) do
        local cf = pivotOf(folder:FindFirstChild(name))
        if cf then table.insert(found, cf) end
    end

    for _, index in ipairs(METEORITE_INDEXES) do
        local cf = pivotOf(children[index])
        if cf then table.insert(found, cf) end
    end

    local best, bestDist = nil, math.huge

    for _, cf in ipairs(found) do
        local dist = (cf.Position - fromPosition).Magnitude
        if dist < bestDist then
            best = cf
            bestDist = dist
        end
    end

    return best
end

local function islandActive()
    local map = workspace:FindFirstChild("Map")
    local bossMap = map and map:FindFirstChild("DungeonBoss_MAP")

    return bossMap ~= nil
        and bossMap:FindFirstChild("Island_Start") ~= nil
end

-- DUNGEON DOOR
local function getNearestDoor(fromPosition)
    local map = workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("DungeonDoorBoss")
    if not folder then return nil end

    local best, bestDist = nil, math.huge

    for _, child in ipairs(folder:GetChildren()) do
        local door = child:FindFirstChild("PartDoor")

        if door and door:IsA("BasePart") then
            local dist = (door.Position - fromPosition).Magnitude
            if dist < bestDist then
                best = door
                bestDist = dist
            end
        end
    end

    return best
end

local function runDungeon(char, root)
    local door = getNearestDoor(root.Position)
    if not door then return end

    -- Teleport to door
    char:PivotTo(door.CFrame + DOOR_OFFSET)
    task.wait(0.5)

    -- Activate door prompt
    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt", true
    )

    if prompt and prompt.Enabled then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.1)
        prompt:InputHoldEnd()
    end

    task.wait(0.5)

    -- Teleport to dungeon destination
    char:PivotTo(DUNGEON_DESTINATION)

    -- Wait 30 seconds, then activate F
    task.wait(DUNGEON_SKILL_DELAY)
    activateSkill("F")
end

-- AUTO EQUIP
local function equipSelectedTool()
    if not state.Equip or not selectedTool then return end

    local char = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if not char or not backpack or not humanoid
        or humanoid.Health <= 0 then
        return
    end

    if not selectedTool.Parent then
        selectedTool = nil
        return
    end

    if selectedTool.Parent == char then return end

    if selectedTool.Parent == backpack then
        humanoid:EquipTool(selectedTool)
    end
end

