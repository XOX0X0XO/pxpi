-- MAIN AUTO LOOP
task.spawn(function()
    while true do
        task.wait(CHECK_INTERVAL)

        if busy then continue end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root then continue end

        local dungeonActive =
            state.Dungeon
            and getNearestDoor(root.Position) ~= nil

        if dungeonActive then
            local inside =
                (root.Position - DUNGEON_DESTINATION.Position).Magnitude
                <= DUNGEON_INSIDE_RANGE

            if not inside then
                busy = true

                local success, err = pcall(function()
                    runDungeon(char, root)
                end)

                if not success then
                    warn("Auto Dungeon error:", err)
                end

                busy = false
            end

        elseif state.Meteorite and not islandActive() then
            local target = getMeteoriteCFrame(root.Position)

            if target
                and (root.Position - target.Position).Magnitude
                    > METEORITE_NEAR_RANGE then

                char:PivotTo(target + METEORITE_OFFSET)

                -- Wait 5 seconds, then activate C
                task.wait(METEORITE_SKILL_DELAY)
                activateSkill("C")
            end
        end
    end
end)

