local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remote = ReplicatedStorage:WaitForChild("AutoDungeon")

local DESTINATION = CFrame.new(
    2465.39526, 2461.83154, -668.35083,
    0.645107985, 0.241587579, -0.724893808,
    -0.145664304, 0.970185637, 0.193705022,
    0.75007838, -0.0193695221, 0.661065221
)

local CHECK_INTERVAL = 3          -- seconds between auto attempts
local ALREADY_INSIDE_RANGE = 150  -- studs from DESTINATION counted as "inside"

local bossFolder = workspace:WaitForChild("Map"):WaitForChild("DungeonDoorBoss")
local enabled = {}   -- [player] = true/false

-- True if any door (normal village, cave, any name) currently exists
local function doorExists()
    for _, child in bossFolder:GetChildren() do
        if child:FindFirstChild("PartDoor") then return true end
    end
    return false
end

local function joinDungeon(player)
    local char = player.Character
    if char and doorExists() then
        char:PivotTo(DESTINATION)
    end
end

-- Manual use: players can still trigger the door prompt themselves
local function hook(prompt)
    if prompt:IsA("ProximityPrompt") and prompt.Parent and prompt.Parent.Name == "PartDoor" then
        prompt.Triggered:Connect(joinDungeon)
    end
end
for _, d in bossFolder:GetDescendants() do hook(d) end
bossFolder.DescendantAdded:Connect(function(d) task.defer(hook, d) end)

-- Button toggles auto-dungeon
remote.OnServerEvent:Connect(function(player)
    enabled[player] = not enabled[player]
    remote:FireClient(player, enabled[player])
end)

-- Auto loop
task.spawn(function()
    while true do
        task.wait(CHECK_INTERVAL)
        for player, on in enabled do
            if on then
                local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if root and (root.Position - DESTINATION.Position).Magnitude > ALREADY_INSIDE_RANGE then
                    joinDungeon(player)
                end
            end
        end
    end
end)

Players.PlayerRemoving:Connect(function(p)
    enabled[p] = nil
end)
