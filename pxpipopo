local function refreshInventory()
    for _, child in ipairs(toolList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    local tools = {}
    local backpack = player:FindFirstChildOfClass("Backpack")
    local char = player.Character

    if backpack then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") then table.insert(tools, obj) end
        end
    end

    if char then
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then table.insert(tools, obj) end
        end
    end

    table.sort(tools, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    if #tools == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -8, 0, 30)
        empty.BackgroundTransparency = 1
        empty.Text = "No Tools found"
        empty.TextColor3 = Color3.fromRGB(190, 190, 200)
        empty.Parent = toolList
        return
    end

    for index, tool in ipairs(tools) do
        local itemButton = Instance.new("TextButton")
        itemButton.Size = UDim2.new(1, -8, 0, 30)
        itemButton.LayoutOrder = index
        itemButton.Text = tool.Name ..
            (selectedTool == tool and "  [SELECTED]" or "")
        itemButton.BackgroundColor3 =
            selectedTool == tool
            and ON_COLOR
            or Color3.fromRGB(60, 65, 80)
        itemButton.TextColor3 = Color3.new(1, 1, 1)
        itemButton.TextSize = 14
        itemButton.Font = Enum.Font.Gotham
        itemButton.Parent = toolList

        itemButton.Activated:Connect(function()
            selectedTool = tool
            refreshInventory()
            equipSelectedTool()
        end)
    end
end

