local function getTools()
    local tools = {}
    local backpack = player:FindFirstChildOfClass("Backpack")
    local character = player.Character

    if backpack then
        for _, obj in ipairs(backpack:GetChildren()) do
            if obj:IsA("Tool") then
                table.insert(tools, obj)
            end
        end
    end

    if character then
        for _, obj in ipairs(character:GetChildren()) do
            if obj:IsA("Tool") then
                table.insert(tools, obj)
            end
        end
    end

    table.sort(tools, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    return tools
end

local function equipSelectedTool()
    if not autoEquip or not selectedToolName then
        return
    end

    local character = player.Character
    local backpack = player:FindFirstChildOfClass("Backpack")
    if not character or not backpack then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end

    local equipped = character:FindFirstChildOfClass("Tool")
    if equipped and equipped.Name == selectedToolName then
        return
    end

    local tool = backpack:FindFirstChild(selectedToolName)
    if tool and tool:IsA("Tool") then
        humanoid:EquipTool(tool)
    end
end

local function refreshInventory()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local tools = getTools()

    for index, tool in ipairs(tools) do
        local toolName = tool.Name
        local itemButton = Instance.new("TextButton")
        itemButton.Name = "ToolOption"
        itemButton.Size = UDim2.new(1, -10, 0, 32)
        itemButton.BackgroundColor3 =
            toolName == selectedToolName
            and Color3.fromRGB(45, 145, 85)
            or Color3.fromRGB(62, 66, 78)
        itemButton.TextColor3 = Color3.new(1, 1, 1)
        itemButton.TextSize = 14
        itemButton.Font = Enum.Font.Gotham
        itemButton.Text = toolName
        itemButton.LayoutOrder = index
        itemButton.Parent = list

        Instance.new("UICorner", itemButton).CornerRadius =
            UDim.new(0, 6)

        itemButton.Activated:Connect(function()
            selectedToolName = toolName
            refreshInventory()
            equipSelectedTool()
        end)
    end

    if #tools == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -10, 0, 32)
        empty.BackgroundTransparency = 1
        empty.Text = "No Tools found"
        empty.TextColor3 = Color3.fromRGB(200, 200, 200)
        empty.Parent = list
    end
end

