-- Activate a skill once
local function activateSkill(key)
    local char = player.Character
    local sukuna = char and char:FindFirstChild("Sukuna")
    local skill = sukuna and sukuna:FindFirstChild("Skill")
    local ev = skill and skill:FindFirstChild("SkillEvent")

    if ev and ev:IsA("RemoteEvent") then
        ev:FireServer(key)
    end
end

-- Meteorite helpers
local function pivotOf(inst)
    if inst and inst:IsA("PVInstance") then
        return inst:GetPivot()
    end

    return nil
end

local function getMeteoriteCFrame(fromPosition)
    local mod = workspace:FindFirstChild("Mod")
    local eventFolder = mod and mod:FindFirstChild("MeteoriteEvent")

    if not eventFolder then
        return nil
    end

    local children = eventFolder:GetChildren()
    local found = {}

    for _, name in METEORITE_NAMES do
        local cf = pivotOf(eventFolder:FindFirstChild(name))

        if cf then
            table.insert(found, cf)
        end
    end

    for _, index in METEORITE_INDEXES do
        local cf = pivotOf(children[index])

        if cf then
            table.insert(found, cf)
        end
    end

    local best, bestDist = nil, math.huge

    for _, cf in found do
        local d = (cf.Position - fromPosition).Magnitude

        if d < bestDist then
            best = cf
            bestDist = d
        end
    end

    return best
end

-- Pause Auto Meteorite while the dungeon island exists
local function islandActive()
    local map = workspace:FindFirstChild("Map")
    local bossMap = map and map:FindFirstChild("DungeonBoss_MAP")

    return bossMap ~= nil
        and bossMap:FindFirstChild("Island_Start") ~= nil
end

-- Find nearest dungeon door
local function getNearestDoor(fromPosition)
    local map = workspace:FindFirstChild("Map")
    local bossFolder = map and map:FindFirstChild("DungeonDoorBoss")

    if not bossFolder then
        return nil
    end

    local best, bestDist = nil, math.huge

    for _, child in bossFolder:GetChildren() do
        local door = child:FindFirstChild("PartDoor")

        if door and door:IsA("BasePart") then
            local d = (door.Position - fromPosition).Magnitude

            if d < bestDist then
                best = door
                bestDist = d
            end
        end
    end

    return best
end

-- Run dungeon and activate F once after teleport
local function runDungeon(char, root)
    local door = getNearestDoor(root.Position)

    if not door then
        return
    end

    -- 1. Teleport to the door
    char:PivotTo(door.CFrame + DOOR_OFFSET)
    task.wait(0.5)

    -- 2. Activate proximity prompt
    local prompt = door:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if prompt and prompt.Enabled then
        prompt:InputHoldBegin()
        task.wait(prompt.HoldDuration + 0.1)
        prompt:InputHoldEnd()
    end

    task.wait(0.5)

    -- 3. Teleport to dungeon destination
    char:PivotTo(DUNGEON_DESTINATION)

    -- 4. Wait, then activate F once
    task.wait(1)
    activateSkill("F")
end

