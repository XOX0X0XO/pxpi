local toggles = {}

local function refresh(feature)
	local t = toggles[feature]
	local on = state[feature]
	t.button.Text = t.label .. ": " .. (on and "ON" or "OFF")
	t.button.BackgroundColor3 = on and ON_COLOR or OFF_COLOR
end

local function makeToggle(feature, label, yOffset)
	local b = Instance.new("TextButton")
	b.AnchorPoint = Vector2.new(0.5, 0)
	b.Position = UDim2.new(0.5, 0, 0, yOffset)
	b.Size = UDim2.new(0.85, 0, 0, 80)
	b.TextSize = 24
	b.Font = Enum.Font.GothamBold
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Parent = frame
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 12)

	toggles[feature] = { button = b, label = label }
	b.MouseButton1Click:Connect(function()
		state[feature] = not state[feature]
		refresh(feature)
	end)
	refresh(feature)
end

makeToggle("meteorite", "Auto Meteorite", 80)
makeToggle("dungeon", "Auto Dungeon", 180)

openButton.MouseButton1Click:Connect(function()
	frame.Visible = not frame.Visible
end)
closeButton.MouseButton1Click:Connect(function()
	frame.Visible = false
end)

-- Auto loop
-- Dungeon runs first when ON and a door exists.
-- Meteorite is blocked while Map.DungeonBoss_MAP.Island_Start exists.
task.spawn(function()
	while true do
		task.wait(CHECK_INTERVAL)
		if busy then continue end

		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		local dungeonActive = state.dungeon and getNearestDoor(root.Position) ~= nil

		if dungeonActive then
			local inside = (root.Position - DUNGEON_DESTINATION.Position).Magnitude <= DUNGEON_INSIDE_RANGE
			if not inside then
				busy = true
				runDungeon(char, root)
				busy = false
			end
		elseif state.meteorite and not islandActive() then
			local target = getMeteoriteCFrame(root.Position)
			if target and (root.Position - target.Position).Magnitude > METEORITE_NEAR_RANGE then
				char:PivotTo(target + METEORITE_OFFSET)
			end
		end
	end
end)
