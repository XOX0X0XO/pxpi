-- Auto loop (dungeon has priority while a door exists)
task.spawn(function()
	while true do
		task.wait(CHECK_INTERVAL)
		if busy then continue end

		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		local dungeonActive = state.dungeon and getNearestDoor(root.Position) ~= nil

		if dungeonActive then
			-- Dungeon first: if you're not in the room yet, run the full sequence
			local inside = (root.Position - DUNGEON_DESTINATION.Position).Magnitude <= DUNGEON_INSIDE_RANGE
			if not inside then
				busy = true
				runDungeon(char, root)
				busy = false
			end
		elseif state.meteorite then
			-- Meteorite only runs when the dungeon is off or no door exists
			local target = getMeteoriteCFrame(root.Position)
			if target and (root.Position - target.Position).Magnitude > METEORITE_NEAR_RANGE then
				char:PivotTo(target + METEORITE_OFFSET)
			end
		end
	end
end)