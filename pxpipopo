local function watchBackpack(backpack)
    backpack.ChildAdded:Connect(function()
        task.wait(0.1)
        refreshInventory()
        equipSelectedTool()
    end)

    backpack.ChildRemoved:Connect(function()
        task.wait(0.1)
        refreshInventory()
    end)
end

