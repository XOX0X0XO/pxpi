-- Settings
local DUNGEON_DESTINATION = CFrame.new(
	2465.39526, 2461.83154, -668.35083,
	0.645107985, 0.241587579, -0.724893808,
	-0.145664304, 0.970185637, 0.193705022,
	0.75007838, -0.0193695221, 0.661065221
)
local CHECK_INTERVAL = 3
local DUNGEON_INSIDE_RANGE = 150
local METEORITE_NEAR_RANGE = 80
local METEORITE_OFFSET = Vector3.new(0, 5, 5)
local METEORITE_INDEXES = { 15, 16 }
local METEORITE_NAMES = { "Meteorite" }

local ON_COLOR = Color3.fromRGB(60, 170, 80)
local OFF_COLOR = Color3.fromRGB(200, 60, 50)

local state = { meteorite = false, dungeon = false }

-- Find targets
local function pivotOf(inst)
	if inst and inst:IsA("PVInstance") then
		return inst:GetPivot()
	end
	return nil
end

local function getMeteoriteCFrame(fromPosition)
	local mod = workspace:FindFirstChild("Mod")
	local eventFolder = mod and mod:FindFirstChild("MeteoriteEvent")
	if not eventFolder then return nil end

	local children = eventFolder:GetChildren()
	local found = {}

	for _, name in METEORITE_NAMES do
		local cf = pivotOf(eventFolder:FindFirstChild(name))
		if cf then table.insert(found, cf) end
	end
	for _, index in METEORITE_INDEXES do
		local cf = pivotOf(children[index])
		if cf then table.insert(found, cf) end
	end

	local best, bestDist = nil, math.huge
	for _, cf in found do
		local d = (cf.Position - fromPosition).Magnitude
		if d < bestDist then best, bestDist = cf, d end
	end
	return best
end

local function doorExists()
	local map = workspace:FindFirstChild("Map")
	local bossFolder = map and map:FindFirstChild("DungeonDoorBoss")
	if not bossFolder then return false end
	for _, child in bossFolder:GetChildren() do
		if child:FindFirstChild("PartDoor") then return true end
	end
	return false
end

